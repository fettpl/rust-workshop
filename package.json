{
  "name": "rust-workshop",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || ^26.12.1"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "pretypecheck": "next typegen",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:offline": "node scripts/verify-offline.mjs",
    "content:check": "node --import tsx scripts/validate-content.ts && node --import tsx scripts/course-text-inventory.ts",
    "content:rust": "node --import tsx scripts/verify-rust.ts",
    "postinstall": "node scripts/setup-assets.mjs",
    "content:audit": "node --import tsx scripts/audit-sources.ts",
    "format": "prettier --write src scripts tests *.ts *.mjs",
    "content:packages": "node --import tsx scripts/build-project-assets.ts",
    "content:client-retry": "node --import tsx scripts/verify-client-retry.ts",
    "content:authorization": "node --import tsx scripts/verify-authorization.ts",
    "content:file-schema-evolution": "node --import tsx scripts/verify-file-schema-evolution.ts",
    "test:authorization": "node node_modules/vitest/vitest.mjs run scripts/verify-authorization.test.ts scripts/verify-client-retry.test.ts src/content/projects/service-authorization/package.test.ts",
    "audit:production": "node scripts/audit-production.mjs",
    "test:audit-production": "node --test scripts/audit-production.test.mjs",
    "test:sharp-runtime": "node --test scripts/verify-sharp-runtime.test.mjs",
    "precontent:capstone": "npm run content:packages",
    "content:capstone": "node --import tsx scripts/verify-capstone.ts",
    "predev": "npm run content:packages",
    "prebuild": "npm run content:packages",
    "content:cargo": "npm run content:packages && node --import tsx scripts/verify-packages.ts",
    "precontent:property": "npm run content:packages",
    "content:property": "node --import tsx scripts/verify-property-contracts.ts",
    "precontent:models": "npm run content:packages",
    "content:models": "node --import tsx scripts/verify-models.ts",
    "content:tokio": "node --import tsx scripts/verify-tokio.ts",
    "content:async-lending": "node --import tsx scripts/verify-async-lending.ts",
    "precontent:operations": "npm run content:packages",
    "content:operations": "node --import tsx scripts/verify-operations.ts",
    "precontent:ffi": "npm run content:packages",
    "content:ffi": "node --import tsx scripts/verify-ffi.ts",
    "precontent:miri": "npm run content:packages",
    "content:miri": "node --import tsx scripts/verify-miri.ts",
    "content:borrowed-memory": "node --import tsx scripts/verify-borrowed-memory.ts",
    "precontent:workspace": "npm run content:packages",
    "content:workspace": "node --import tsx scripts/verify-workspace.ts",
    "content:supply-chain": "node --import tsx scripts/verify-supply-chain.ts",
    "precontent:supply-chain": "npm run content:packages",
    "content:manifests": "node --import tsx scripts/verify-manifests.ts",
    "precontent:performance": "npm run content:packages",
    "content:performance": "node --import tsx scripts/verify-performance.ts",
    "precontent:profiles": "npm run content:packages",
    "content:profiles": "node --import tsx scripts/verify-profiles.ts",
    "precontent:allocations": "npm run content:packages",
    "content:allocations": "node --import tsx scripts/verify-allocations.ts",
    "precontent:fuzz": "npm run content:packages",
    "content:fuzz": "node --import tsx scripts/verify-mini-grep-fuzz.ts",
    "precontent:guessing": "npm run content:packages",
    "content:guessing": "node --import tsx scripts/verify-number-guessing.ts",
    "content:api-release": "node --import tsx scripts/verify-api-release.ts",
    "test:api-release": "vitest run scripts/verify-api-release.test.ts",
    "content:macro-contracts": "node --import tsx scripts/verify-macro-contracts.ts",
    "test:macro-contracts": "vitest run scripts/verify-macro-contracts.test.ts"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "dompurify": "3.4.18",
    "idb": "^8.0.4",
    "lucide-react": "^1.61.0",
    "monaco-editor": "0.57.0",
    "next": "16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "toml-eslint-parser": "1.0.3",
    "typescript": "^6.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.5",
    "fake-indexeddb": "^6.2.6",
    "fflate": "^0.8.3",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "monaco-editor": {
      "dompurify": "$dompurify"
    }
  }
}
